{
  "servers": [
    {
      "name": "applemusic",
      "type": "stdio",
      "command": "uvx",
      "args": [
        "-p", "3.13", "-n", "mcp-applemusic"
      ]
    },
    {
      "name": "google-maps",
      "command": "env",
      "args": [
        "GOOGLE_MAPS_API_KEY=<INSERT_YOUR_API_KEY>",
        "GOOGLE_MAPS_ENABLED_TOOLS=maps_geocode,maps_reverse_geocode,maps_directions,maps_search_places,maps_search_along_route,maps_search_nearby,maps_plan_route,maps_explore_area,maps_compare_places",
        "npx", "-y", "@cablate/mcp-google-map", "--stdio"
      ]
    },
    {
      "name": "messages",
      "command": "uvx",
      "args": [
        "--with", "mcp<1.3",
        "mac-messages-mcp"
      ]
    }
  ]
}
